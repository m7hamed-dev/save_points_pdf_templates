.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# The example app is tracked (pub.dev scores it and it guards the public API);
# its own .gitignore excludes build output.

# Golden output rejected by a failing comparison. The reference files beside
# them are tracked; these are written only to be looked at, then deleted.
test/goldens/*.actual.txt

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
